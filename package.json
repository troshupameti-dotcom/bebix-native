{
  "name": "bebix-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "check-deps": "expo install --check",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "lint": "expo lint",
    "test": "jest",
    "preflight": "tsc --noEmit && eslint . --ext .ts,.tsx && jest --ci",
    "eas-build-post-install": "tsc --noEmit && jest --ci"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/ui": "~58.0.25",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.109.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.21",
    "expo-apple-authentication": "~58.0.2",
    "expo-auth-session": "~58.0.16",
    "expo-brightness": "~58.0.2",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.28",
    "expo-screen-capture": "~58.0.6",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.25",
    "lucide-react-native": "1.57.0",
    "moti": "^0.30.0",
    "nativewind": "^4.2.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-android-widget": "^0.22.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "react-test-renderer": "19.3.0",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.13",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "react-native-gesture-handler/jestSetup.js",
      "<rootDir>/__tests__/helpers/jestSetup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
