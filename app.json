{
  "expo": {
    "name": "Bebix",
    "slug": "bebix",
    "scheme": "bebix",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bebix.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Bebix përdor kamerën për të shtuar foto të bebit tënd.",
        "NSPhotoLibraryUsageDescription": "Bebix përdor galerinë për të zgjedhur foto të bebit tënd.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Bebix përdor mikrofonin kur regjistron një video për Komunitetin."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.bebix.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F6F2"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#1F3D38"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F3F3F1"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-router",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video",
      "@sentry/react-native",
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0797c8a5-c2a5-4d7d-9d7a-d5c60743b62a"
      }
    }
  }
}
