{
  "expo": {
    "name": "Bebix",
    "slug": "bebix",
    "scheme": "bebix",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.bebix.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Bebix përdor kamerën për të shtuar foto të bebit tënd.",
        "NSPhotoLibraryUsageDescription": "Bebix përdor galerinë për të zgjedhur foto të bebit tënd.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Bebix përdor mikrofonin kur regjistron një video për Komunitetin."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.bebix.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F3F1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1F3D38"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F3F3F1",
          "android": {
            "image": "./assets/splash-android.png",
            "imageWidth": 288,
            "resizeMode": "contain",
            "backgroundColor": "#F3F3F1"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-router",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video",
      "@sentry/react-native",
      "expo-apple-authentication",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BebixQuick",
              "label": "Bebix",
              "description": "Ushqimi, pelena dhe gjumi me një prekje",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.bebix.app.widgets",
          "groupIdentifier": "group.com.bebix.app",
          "frequentUpdates": false,
          "widgets": [
            {
              "name": "BebixQuick",
              "displayName": "Bebix",
              "description": "Ushqimi, pelena dhe gjumi me një prekje",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryCircular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      "./plugins/withBebixShortcuts",
      "./plugins/withBebixAppIntents"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0797c8a5-c2a5-4d7d-9d7a-d5c60743b62a"
      }
    }
  }
}
